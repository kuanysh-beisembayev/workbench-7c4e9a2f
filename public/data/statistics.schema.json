{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "patch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "isDemo": {
      "type": "boolean"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "scope": {
      "type": "string",
      "maxLength": 200
    },
    "sourceUrls": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "roleStats": {
      "maxItems": 20000,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "heroId": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "role": {
                "type": "string",
                "enum": [
                  "carry",
                  "mid",
                  "offlane",
                  "support",
                  "hard-support"
                ]
              },
              "rank": {
                "type": "string",
                "enum": [
                  "all",
                  "herald",
                  "guardian",
                  "crusader",
                  "archon",
                  "legend",
                  "ancient",
                  "divine",
                  "immortal"
                ]
              },
              "matches": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000000
              },
              "wins": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "heroId",
              "role",
              "rank",
              "matches",
              "wins"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "heroId": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "role": {
                "type": "string",
                "enum": [
                  "carry",
                  "mid",
                  "offlane",
                  "support",
                  "hard-support"
                ]
              },
              "rank": {
                "type": "string",
                "enum": [
                  "all",
                  "herald",
                  "guardian",
                  "crusader",
                  "archon",
                  "legend",
                  "ancient",
                  "divine",
                  "immortal"
                ]
              },
              "matches": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000000
              },
              "winRate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "heroId",
              "role",
              "rank",
              "matches",
              "winRate"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "matchups": {
      "maxItems": 50000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "heroId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "otherHeroId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "kind": {
            "type": "string",
            "enum": [
              "enemy",
              "ally"
            ]
          },
          "matches": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000
          },
          "advantage": {
            "type": "number",
            "minimum": -25,
            "maximum": 25
          }
        },
        "required": [
          "heroId",
          "otherHeroId",
          "kind",
          "matches",
          "advantage"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "patch",
    "updatedAt",
    "isDemo",
    "source",
    "roleStats",
    "matchups"
  ],
  "additionalProperties": false
}
