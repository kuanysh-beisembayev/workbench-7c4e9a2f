{
  "name": "dota2-picker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24.19.0 <25" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node --experimental-strip-types scripts/validate-data.ts && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "validate:data": "node --experimental-strip-types scripts/validate-data.ts",
    "audit": "node scripts/audit-dependencies.mjs",
    "deploy": "pnpm test && pnpm run audit && pnpm build && node scripts/deploy.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
